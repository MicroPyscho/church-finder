# .env.example — copy to .env for local dev
# NEVER commit .env files with real values

# ─── Core ─────────────────────────────────────────────────────────────────────
ENV=dev
APP_VERSION=0.0.0-dev

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/churchfinder

# ─── Notifications ────────────────────────────────────────────────────────────
NOTIFY_METHOD=none          # none | email | webhook | both
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
WEBHOOK_URL=

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-not-for-prod-change-me