// ─── MINI MAP WITH PINS ───────────────────────────────────────────────────────
function MiniMap({ pins, activeFilters, onPinClick, selectedPin }) {
  // Project lat/lon to SVG coords (simple linear for UK bounds)
  function project(lat, lon) {
    const x = ((lon - (-8.2)) / (2.2 - (-8.2))) * 320;
    const y = ((61.0 - lat) / (61.0 - 49.5)) * 340;
    return { x, y };
  }

  const filteredPins = activeFilters.length === 0
    ? pins
    : pins.filter(p => activeFilters.includes(p.type));

  return (
    <div style={{ position: "relative", width: "100%", height: "100%", background: "#0a0a14", borderRadius: 8, overflow: "hidden" }}>
      {/* Grid lines */}
      <svg style={{ position: "absolute", inset: 0, width: "100%", height: "100%", opacity: 0.15 }}>
        {[0,25,50,75,100].map(p => (
          <g key={p}>
            <line x1={`${p}%`} y1="0" x2={`${p}%`} y2="100%" stroke="#378ADD" strokeWidth="0.5"/>
            <line x1="0" y1={`${p}%`} x2="100%" y2={`${p}%`} stroke="#378ADD" strokeWidth="0.5"/>
          </g>
        ))}
      </svg>

      {/* Pins */}
      <svg viewBox="0 0 320 340" style={{ position: "absolute", inset: 0, width: "100%", height: "100%", overflow: "visible" }}>
        {filteredPins.map(pin => {
          const { x, y } = project(pin.lat, pin.lon);
          const col = typeColor(pin.type);
          const isSelected = selectedPin?.id === pin.id;
          return (
            <g key={pin.id} onClick={() => onPinClick(pin)} style={{ cursor: "pointer" }}>
              {/* Pulse ring */}
              {isSelected && (
                <circle cx={x} cy={y} r="14" fill="none" stroke={col} strokeWidth="1.5" opacity="0.5">
                  <animate attributeName="r" from="10" to="20" dur="1.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" from="0.6" to="0" dur="1.5s" repeatCount="indefinite"/>
                </circle>
              )}
              {/* Pin circle */}
              <circle cx={x} cy={y} r={isSelected ? 8 : 5}
                fill={col} fillOpacity="0.9"
                stroke={isSelected ? "#fff" : col}
                strokeWidth={isSelected ? 1.5 : 0.5}
                style={{ filter: `drop-shadow(0 0 ${isSelected ? 8 : 4}px ${col})` }}
              />
            </g>
          );
        })}
      </svg>

      {/* Tooltip for selected pin */}
      {selectedPin && (() => {
        const { x, y } = project(selectedPin.lat, selectedPin.lon);
        const col = typeColor(selectedPin.type);
        const pctX = (x / 320) * 100;
        const left = pctX > 60 ? "auto" : `${pctX + 3}%`;
        const right = pctX > 60 ? `${100 - pctX + 3}%` : "auto";
        return (
          <div style={{
            position: "absolute",
            left, right,
            top: `${(y / 340) * 100}%`,
            transform: "translateY(-50%)",
            background: "#14141F",
            border: `1px solid ${col}44`,
            borderLeft: `3px solid ${col}`,
            borderRadius: 6,
            padding: "8px 12px",
            maxWidth: 180,
            zIndex: 10,
            pointerEvents: "none",
          }}>
            <p style={{ margin: 0, fontSize: 11, color: col, fontFamily: "'Cinzel', serif", letterSpacing: 1 }}>
              {selectedPin.type.toUpperCase().replace("_", " ")}
            </p>
            <p style={{ margin: "4px 0 2px", fontSize: 12, color: "#E8E6E0", fontWeight: 500, lineHeight: 1.3 }}>
              {selectedPin.name}
            </p>
            <p style={{ margin: 0, fontSize: 11, color: "#888780" }}>{selectedPin.city}</p>
          </div>
        );
      })()}

      <p style={{ position: "absolute", bottom: 6, right: 8, fontSize: 10, color: "#44445A", margin: 0, fontFamily: "monospace" }}>
        OSM + Wikidata • {filteredPins.length} sites
      </p>
    </div>
  );
}

