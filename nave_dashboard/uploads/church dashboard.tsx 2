  );
}

// ─── FILTER PILL ─────────────────────────────────────────────────────────────
function FilterPill({ type, active, onClick }) {
  const col = typeColor(type.id);
  return (
    <button
      onClick={onClick}
      style={{
        display: "flex", alignItems: "center", gap: 6,
        padding: "5px 10px",
        background: active ? `${col}22` : "#0F0F1C",
        border: `1px solid ${active ? col : "#1E1E30"}`,
        borderRadius: 20,
        cursor: "pointer",
        color: active ? col : "#888780",
        fontSize: 11,
        fontFamily: "'Cinzel', serif",
        letterSpacing: "0.05em",
        transition: "all 0.2s",
        boxShadow: active ? `0 0 8px ${col}44` : "none",
      }}
    >
      <span style={{ width: 7, height: 7, borderRadius: 2, background: active ? col : "#333", flexShrink: 0 }}/>
      {type.label}
    </button>
  );
}

// ─── SPARKLINE BAR ───────────────────────────────────────────────────────────
function BreakdownBar({ data, total, activeFilters }) {
  return (
    <div style={{ display: "flex", height: 8, borderRadius: 4, overflow: "hidden", gap: 1, margin: "10px 0 4px" }}>
      {data.filter(t => t.id !== "unknown").map(t => {
        const w = (t.count / total) * 100;
        const col = typeColor(t.id);
        const dimmed = activeFilters.length > 0 && !activeFilters.includes(t.id);
        return (
          <div key={t.id} title={`${t.label}: ${t.count}`} style={{
            width: `${w}%`, background: col, opacity: dimmed ? 0.2 : 1, transition: "opacity 0.3s",
            boxShadow: dimmed ? "none" : `0 0 4px ${col}88`,
          }}/>
        );
      })}
    </div>
  );
}

// ─── DATA TABLE ──────────────────────────────────────────────────────────────
function DataTable({ pins, activeFilters }) {
  const rows = activeFilters.length === 0 ? pins : pins.filter(p => activeFilters.includes(p.type));
  return (
    <div style={{ overflowX: "auto" }}>
      <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12, fontFamily: "Inter, sans-serif" }}>
        <thead>
          <tr style={{ borderBottom: "1px solid #1E1E30" }}>
            {["Type", "Former Building", "City", "Coordinates"].map(h => (
              <th key={h} style={{ padding: "8px 12px", textAlign: "left", color: "#888780", fontWeight: 500,
                fontSize: 10, letterSpacing: "0.1em", fontFamily: "'Cinzel', serif" }}>
                {h.toUpperCase()}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(pin => {
            const col = typeColor(pin.type);
            return (
              <tr key={pin.id} style={{ borderBottom: "1px solid #14141F" }}
                onMouseEnter={e => e.currentTarget.style.background = "#14141F"}
                onMouseLeave={e => e.currentTarget.style.background = "transparent"}
              >
                <td style={{ padding: "8px 12px" }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                    <ConversionIcon type={pin.type} size={16}/>
                    <span style={{ color: col, fontSize: 10, letterSpacing: "0.08em", fontFamily: "'Cinzel', serif" }}>
                      {pin.type.replace("_", " ").toUpperCase()}
                    </span>
                  </div>
                </td>
                <td style={{ padding: "8px 12px", color: "#C8C6C0" }}>{pin.name}</td>
                <td style={{ padding: "8px 12px", color: "#888780" }}>{pin.city}</td>
                <td style={{ padding: "8px 12px", color: "#44445A", fontFamily: "monospace", fontSize: 11 }}>
                  {pin.lat.toFixed(3)}°N, {Math.abs(pin.lon).toFixed(3)}°W
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}

