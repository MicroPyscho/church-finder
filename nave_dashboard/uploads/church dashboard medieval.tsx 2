// ── TREASURE MAP ILLUSTRATION PINS ──────────────────────────────────────────
function MapPin({ x, y, type, name, isSelected, onClick }) {
  const col = typeColor(type);

  const icons = {
    mosque:      "☽",
    hospitality: "🍺",
    residential: "🗝",
    arts:        "🎭",
    community:   "✦",
    other_faith: "✡",
    education:   "📖",
    commercial:  "⚔",
    unknown:     "?",
  };

  return (
    <g onClick={onClick} style={{ cursor: "pointer" }}>
      {isSelected && (
        <circle cx={x} cy={y - 14} r="20" fill={col} fillOpacity="0.12"
          stroke={col} strokeWidth="1" strokeOpacity="0.4" strokeDasharray="3 2"/>
      )}
      {/* Pin shadow */}
      <ellipse cx={x + 1} cy={y + 1} rx="8" ry="8" fill="#3a2000" fillOpacity="0.3" filter="url(#ink-bleed)"/>
      {/* Pin head */}
      <circle cx={x} cy={y - 14} r="8" fill={col} fillOpacity="0.9" stroke="#2a1500" strokeWidth="1"/>
      {/* Icon inside pin */}
      <text x={x} y={y - 11} textAnchor="middle" fontSize="8" style={{ pointerEvents: "none" }}>
        {icons[type] || "·"}
      </text>
      {/* Pin needle */}
      <line x1={x} y1={y - 6} x2={x} y2={y} stroke="#2a1500" strokeWidth="1.5"/>
      {/* Tooltip */}
      {isSelected && (
        <g transform={`translate(${x > 280 ? x - 130 : x + 12}, ${y - 40})`}>
          <rect width="120" height="36" rx="3" fill="#2a1500" fillOpacity="0.9" stroke="#8B6914" strokeWidth="1"/>
          <text x="8" y="14" fontSize="8" fill="#F5E6C8" fontFamily="'Palatino Linotype', serif" fontWeight="bold">
            {name.length > 20 ? name.slice(0, 20) + "…" : name}
          </text>
          <text x="8" y="27" fontSize="7" fill="#C8A060">
            {type.replace("_", " ")}
          </text>
        </g>
      )}
    </g>
  );
}

