// ── SCROLL / LEGEND PANEL ─────────────────────────────────────────────────────
function ScrollPanel({ children, title }) {
  return (
    <div style={{
      background: "linear-gradient(160deg, #2a1800 0%, #1a0f00 100%)",
      border: "2px solid #8B6914",
      borderRadius: 4,
      padding: "14px 16px",
      position: "relative",
    }}>
      {/* Corner flourishes */}
      {["0,0","calc(100% - 0px),0","0,calc(100% - 0px)","calc(100% - 0px),calc(100% - 0px)"].map((pos, i) => (
        <div key={i} style={{
          position: "absolute",
          top: i < 2 ? 4 : "auto", bottom: i >= 2 ? 4 : "auto",
          left: i % 2 === 0 ? 4 : "auto", right: i % 2 === 1 ? 4 : "auto",
          width: 10, height: 10,
          borderTop: i < 2 ? "1.5px solid #8B6914" : "none",
          borderBottom: i >= 2 ? "1.5px solid #8B6914" : "none",
          borderLeft: i % 2 === 0 ? "1.5px solid #8B6914" : "none",
          borderRight: i % 2 === 1 ? "1.5px solid #8B6914" : "none",
        }}/>
      ))}
      {title && (
        <p style={{ margin: "0 0 10px", fontSize: 9, letterSpacing: "0.2em", color: "#C8A060",
          fontFamily: "'Palatino Linotype', serif", textAlign: "center", textTransform: "uppercase" }}>
          ✦ {title} ✦
        </p>
      )}
      {children}
    </div>
  );
}

