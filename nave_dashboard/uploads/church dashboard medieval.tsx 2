          <div style={{ textAlign:"right" }}>
            <p style={{ margin:0, fontSize:10, color:"#C8A060", letterSpacing:"0.1em" }}>ANNO DOMINI MMXXVI</p>
            <p style={{ margin:0, fontSize:9, color:"#8B6914" }}>2,496 SITES CATALOGUED</p>
          </div>
        </div>
      </header>

      {/* ── FILTER SCROLLS ── */}
      <div style={{
        padding: "10px 20px",
        borderBottom: "1px solid #5c3a10",
        background: "#140a00",
        display: "flex", gap:6, flexWrap:"wrap", alignItems:"center",
      }}>
        <span style={{ fontSize:9, color:"#8B6914", letterSpacing:"0.15em", marginRight:6 }}>✦ LEGEND ✦</span>
        {CONVERSION_TYPES.filter(t => t.id !== "unknown").map(t => {
          const active = activeFilters.includes(t.id);
          return (
            <button key={t.id} onClick={() => toggleFilter(t.id)} style={{
              background: active ? `${t.color}33` : "#1a0f00",
              border: `1px solid ${active ? t.color : "#5c3a10"}`,
              borderRadius: 2,
              color: active ? "#E8D4A0" : "#8B6914",
              fontSize: 10, padding: "4px 10px", cursor: "pointer",
              fontFamily: FONT, letterSpacing: "0.08em",
              boxShadow: active ? `0 0 6px ${t.color}44, inset 0 0 4px ${t.color}22` : "none",
              transition: "all 0.2s",
            }}>
              {t.label}
            </button>
          );
        })}
        {activeFilters.length > 0 && (
          <button onClick={() => setActiveFilters([])} style={{
            background:"none", border:"1px solid #5c3a10", borderRadius:2,
            color:"#8B6914", fontSize:10, padding:"4px 10px", cursor:"pointer", fontFamily:FONT,
          }}>
            Clear All
          </button>
        )}
      </div>

      {/* ── MAIN LAYOUT ── */}
      <div style={{ display:"grid", gridTemplateColumns:"220px 1fr 220px", gap:0, height:"calc(100vh - 130px)" }}>

        {/* ── LEFT PANEL ── */}
        <aside style={{
          padding: "14px",
          borderRight: "1px solid #5c3a10",
          overflowY: "auto",
          display: "flex", flexDirection: "column", gap: 12,
          background: "linear-gradient(180deg, #140a00 0%, #0f0800 100%)",
        }}>
          <ScrollPanel title="The Count">
            <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
              {[
                { label:"Churches Catalogued", value:"48,151", col:"#C8A060" },
                { label:"Confirmed Conversions", value:"2,496", col:"#E8D4A0" },
                { label:"Become Mosques",  value:"40",  col:"#8B1A1A" },
                { label:"Become Taverns",  value:"71",  col:"#8B3500" },
                { label:"Become Dwellings",value:"70",  col:"#1a3d6b" },
                { label:"Become Halls",    value:"361", col:"#2D6A2D"  },
              ].map(s => (
                <div key={s.label} style={{ borderBottom:"1px solid #3a2000", paddingBottom:8 }}>
                  <p style={{ margin:0, fontSize:9, color:"#8B6914", letterSpacing:"0.1em" }}>{s.label}</p>
                  <p style={{ margin:"3px 0 0", fontSize:20, color:s.col, fontWeight:"bold" }}>{s.value}</p>
                </div>
              ))}
            </div>
          </ScrollPanel>

          <ScrollPanel title="Finding">
            <p style={{ margin:0, fontSize:11, color:"#C8A060", lineHeight:1.8 }}>
              <em>"Taverns outnumber mosques <strong>1.8×</strong> as heirs to the sacred nave."</em>
            </p>
          </ScrollPanel>

          <ScrollPanel title="Data Sources">
            {["Wikidata", "OpenStreetMap", "Historic England", "Charity Commission"].map(s => (
              <p key={s} style={{ margin:"4px 0", fontSize:10, color:"#8B6914", display:"flex", gap:6, alignItems:"center" }}>
                <span style={{ color:"#C8A060" }}>✦</span> {s}
              </p>
            ))}
          </ScrollPanel>
        </aside>

        {/* ── MAP ── */}
        <div style={{ position:"relative", overflow:"hidden", background:"#0a0500" }}>
          <svg style={{ position:"absolute", inset:0, width:"100%", height:"100%" }}>
            <defs>
              <filter id="pin-glow">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
              </filter>
            </defs>
          </svg>
          <div style={{ width:"100%", height:"100%", display:"flex", alignItems:"center", justifyContent:"center", padding:8 }}>
            <div style={{ width:"100%", maxWidth:480, aspectRatio:"420/440" }}>
              <TreasureMap
                pins={PINS}
                activeFilters={activeFilters}
                selectedPin={selectedPin}
                onPinClick={p => setSelectedPin(prev => prev?.id === p.id ? null : p)}
                selectedRegion={selectedRegion}
                onRegionClick={id => setSelectedRegion(prev => prev === id ? null : id)}
              />
            </div>
          </div>

          {/* Selected pin card — floats over map */}
          {selectedPin && (
            <div style={{
              position:"absolute", bottom:16, left:"50%", transform:"translateX(-50%)",
              background:"linear-gradient(135deg, #2a1500 0%, #1a0f00 100%)",
              border:"1px solid #8B6914",
              borderRadius:4, padding:"12px 16px", minWidth:260,
              display:"flex", gap:12, alignItems:"center",
              boxShadow:"0 4px 24px #00000088",
            }}>
              <div style={{ width:3, height:36, background: typeColor(selectedPin.type), borderRadius:2 }}/>
              <div>
                <p style={{ margin:0, fontSize:12, color:"#E8D4A0", fontWeight:"bold" }}>{selectedPin.name}</p>
                <p style={{ margin:"3px 0 0", fontSize:10, color:"#C8A060", letterSpacing:"0.08em" }}>
                  {selectedPin.type.replace("_"," ").toUpperCase()} · {selectedPin.city}
                </p>
              </div>
              <button onClick={() => setSelectedPin(null)} style={{
                marginLeft:"auto", background:"none", border:"none", color:"#8B6914",
                cursor:"pointer", fontSize:14, fontFamily:FONT,
              }}>✕</button>
            </div>
          )}
        </div>

        {/* ── RIGHT PANEL ── */}
        <aside style={{
          padding:"14px",
          borderLeft:"1px solid #5c3a10",
          overflowY:"auto",
          display:"flex", flexDirection:"column", gap:12,
          background:"linear-gradient(180deg, #140a00 0%, #0f0800 100%)",
        }}>
          <ScrollPanel title="By Region">
            {REGIONS.map(r => {
              const col = typeColor(r.dominant);
              const isSelected = selectedRegion === r.id;
              return (
                <button key={r.id} onClick={() => setSelectedRegion(prev => prev === r.id ? null : r.id)}
                  style={{
                    width:"100%", textAlign:"left", background: isSelected ? `${col}22` : "none",
                    border: isSelected ? `1px solid ${col}` : "1px solid transparent",
                    borderRadius:2, padding:"7px 8px", cursor:"pointer", marginBottom:4,
                    display:"flex", justifyContent:"space-between", alignItems:"center",
                    transition:"all 0.2s",
                  }}
                >
                  <span style={{ fontSize:10, color: isSelected ? "#E8D4A0" : "#C8A060", fontFamily:FONT }}>
                    {r.name}
                  </span>
                  <span style={{ fontSize:10, color:col }}>{r.records}</span>
                </button>
              );
            })}
          </ScrollPanel>

          <ScrollPanel title="Bestiary">
            <p style={{ margin:"0 0 8px", fontSize:9, color:"#8B6914", letterSpacing:"0.1em" }}>CONVERSION MARKS</p>
            {[
              { type:"mosque",      sym:"☽", desc:"House of the Crescent" },
              { type:"hospitality", sym:"🍺", desc:"Tavern & Alehouse"     },
              { type:"residential", sym:"🗝", desc:"Private Dwelling"       },
              { type:"arts",        sym:"🎭", desc:"Theatre & Playhouse"    },
              { type:"community",   sym:"✦", desc:"Hall of the People"      },
              { type:"other_faith", sym:"✡", desc:"Other Creed"             },
              { type:"education",   sym:"📖", desc:"School & Library"        },
              { type:"commercial",  sym:"⚔", desc:"Commerce & Trade"        },
            ].map(e => (
              <div key={e.type} style={{ display:"flex", gap:8, alignItems:"center", marginBottom:7 }}>
                <span style={{ fontSize:14, width:18, textAlign:"center" }}>{e.sym}</span>
                <div>
                  <p style={{ margin:0, fontSize:10, color:"#C8A060" }}>{e.desc}</p>
                  <div style={{ width:40, height:2, background:typeColor(e.type), borderRadius:1, marginTop:2 }}/>
                </div>
              </div>
            ))}
          </ScrollPanel>
        </aside>
      </div>

      {/* ── FOOTER ── */}
      <div style={{
        borderTop:"1px solid #5c3a10",
        background:"#0a0500",
        padding:"8px 24px",
        display:"flex", gap:24, alignItems:"center",
        fontSize:10, color:"#5c3a10", letterSpacing:"0.12em",
      }}>
        <span>✦ SACRED SPACES · UK CHURCH CONVERSION RECORD · MMXXVI ✦</span>
        <span style={{ marginLeft:"auto" }}>
          {activeFilters.length > 0 ? `${activeFilters.join(", ").toUpperCase()} ACTIVE` : "ALL RECORDS"}
          {" · "}{selectedRegion ? selectedRegion.toUpperCase() : "ALL REGIONS"}
        </span>
      </div>
    </div>
  );
}
